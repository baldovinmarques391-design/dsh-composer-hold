{
  "name": "dsh-composer-hold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "发送键与停止键分离，并带一道注入闸门：锁定期间后台任务、子代理汇报、定时提醒全被扣住，直到你发消息时一起送进模型。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "meta": {
      "title": "按键分离",
      "description": "运行中按一下只停当前回合，再按一下锁住注入闸门：后台任务、子代理汇报、定时提醒全部扣住，直到你发消息时一起送进模型。"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baldovinmarques391-design/dsh-composer-hold.git"
  }
}
